meta {
  name: Delete Series
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/time-block-series/:seriesId
  body: none
  auth: none
}

params:path {
  seriesId: PASTE_SERIES_ID_HERE
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrfToken}}
}

docs {
  # Delete Series

  Soft delete — the series and its FUTURE occurrences leave the list, but past
  occurrences are preserved (history is immutable). Returns 200.

  Requires ACCESS_TOKEN cookie + X-CSRF-Token header
  (the `csrfToken` env var is auto-filled by the login/register/refresh
  post-response script — never paste it manually).

  Returns 404 when the series does not belong to the user.

  NOTE: the backend log line "Request without Origin and Referer headers"
  is a harmless WARN (fail-open for non-browser clients like Bruno) — it does
  NOT block the request.
}
