meta {
  name: Refresh Token
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/refresh
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

docs {
  # Refresh Access Token
  
  Issues a new access token using the refresh token cookie.
  
  Requires valid REFRESH_TOKEN cookie (7 days validity).
  Returns new ACCESS_TOKEN cookie (15 min validity).
}
