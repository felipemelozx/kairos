meta {
  name: Refresh Token
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/refresh
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

docs {
  # Refresh Access Token

  Issues a new access token using the refresh token cookie.

  Requires valid REFRESH_TOKEN cookie (7 days validity).
  Returns new ACCESS_TOKEN cookie (15 min validity) + a fresh CSRF_TOKEN
  (auto-captured into the `csrfToken` env var by the script below —
  re-run refresh never breaks write requests).
}

script:post-response {
  // Auto-captura o cookie CSRF_TOKEN (rotacionado a cada refresh) para a var
  // de ambiente `csrfToken`, usada pelo header X-CSRF-Token nas escritas.
  // Nao cole o valor manualmente — ele invalida a cada nova autenticacao.
  const headers = res.getHeaders() || {};
  const setCookie = headers['set-cookie'] || headers['Set-Cookie'] || '';
  const raw = Array.isArray(setCookie) ? setCookie.join('\n') : String(setCookie);
  const match = /CSRF_TOKEN=([^;\s]+)/.exec(raw);
  if (match && match[1]) {
    bru.setEnvVar('csrfToken', match[1], { persist: true });
  } else {
    console.log('csrf auto-capture: cookie CSRF_TOKEN nao encontrado no Set-Cookie da resposta');
  }
}
