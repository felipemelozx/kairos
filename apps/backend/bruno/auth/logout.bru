meta {
  name: Logout
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrfToken}}
}

docs {
  # Logout

  Clears authentication cookies (ACCESS_TOKEN and REFRESH_TOKEN).

  Requires valid authentication cookies from login/register PLUS the
  X-CSRF-Token header (logout is NOT in the CSRF skip list — the `csrfToken`
  env var is auto-filled by the login/register/refresh post-response script).
  Without it the API returns 403 "Missing CSRF token".
}
