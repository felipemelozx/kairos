meta {
  name: Update Project
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/projects/:projectId
  body: json
  auth: none
}

params:path {
  projectId: PASTE_PROJECT_ID_HERE
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "name": "Study English (updated)"
  }
}

docs {
  # Update Project

  Partial update — send only the fields to change
  (`name`, `description`, `color`, `status`). Returns 200.

  Requires ACCESS_TOKEN cookie + X-CSRF-Token header
  (the `csrfToken` env var is auto-filled by the login/register/refresh
  post-response script — never paste it manually).

  Returns 400 on validation error, 404 when the project does not belong
  to the user.

  NOTE: the backend log line "Request without Origin and Referer headers"
  is a harmless WARN (fail-open for non-browser clients like Bruno) — it does
  NOT block the request.
}
