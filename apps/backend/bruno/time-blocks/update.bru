meta {
  name: Update Time Block
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/time-blocks/:blockId
  body: json
  auth: none
}

params:path {
  blockId: PASTE_BLOCK_ID_HERE
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "title": "Deep work (updated)"
  }
}

docs {
  # Update Time Block

  Partial update — send only the fields to change
  (`title`, `startDateTime`, `endDateTime`, `projectId`). Returns 200.

  Requires ACCESS_TOKEN cookie + X-CSRF-Token header
  (paste CSRF_TOKEN cookie value into the `csrfToken` environment variable).

  Returns 400 on invalid title/range, 404 when the block (or projectId)
  does not belong to the user.
}
