{
  "name": "kairos-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Kairos - Time-centered productivity system",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "backend:dev": "./scripts/start-backend.sh",
    "backend:build": "cd apps/backend && ./mvnw clean package",
    "frontend:dev": "./scripts/start-frontend.sh",
    "frontend:build": "cd apps/frontend && npm run build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:databases": "docker-compose up -d postgres redis",
    "docker:databases:down": "docker-compose stop postgres redis"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/felipemelozx/kairos.git"
  },
  "author": "Felipe Melo",
  "license": "MIT"
}
